FROM python:3.10-slim

# Install system dependencies for unstructured, camelot-py (PDF parsing) and opencv
RUN apt-get update && apt-get install -y \
    poppler-utils \
    tesseract-ocr \
    libgl1 \
    libglib2.0-0 \
    ghostscript \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Ensure data directories exist
RUN mkdir -p data/raw data/processed data/processed/chunks

# Expose FastAPI port
EXPOSE 8000

# Start server
CMD ["uvicorn", "clause.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
